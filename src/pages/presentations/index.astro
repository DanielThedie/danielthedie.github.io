---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const pageTitle = "Presentations";
const items = await getCollection("presentations");
items.sort((a, b) => (b.data.date ?? "").localeCompare(a.data.date ?? ""));
---

<BaseLayout pageTitle={pageTitle}>
  <ul class="link-list">
    {items.map((p) => (
      <li>
          <a href={`/presentations/${p.data.slug}/`}>
              {p.data.title}
              <div class="event">{p.data.date} - {p.data.event}</div>
          </a>
      </li>
      ))}
  </ul>
</BaseLayout>

<style>
 .event {
     color: #777777;
 }
 
 ul.link-list {
     list-style: none;
     padding: 0;
     margin: 0;
 }

 ul.link-list li + li {
     margin-top: 0.6rem;
 }

 ul.link-list a {
     display: block;
     padding: 0.65rem 0.8rem;
     border-radius: 10px;

     text-decoration: none;
     color: #1f4fd6;

     border: 1px solid transparent;
     background: transparent;

     transition: background-color 0.15s ease, border-color 0.15s ease,
     transform 0.15s ease;
 }

 ul.link-list a {
     border-left: 4px solid #c9c9c9;
     padding-left: 0.9rem;
 }

 ul.link-list a:hover,
 ul.link-list a:focus-visible {
     background: #eeeeee;
     border-color: #d0d0d0;
     transform: translateY(-1px);
     outline: none;
     border-left-color: #1f4fd6;
 }

 ul.link-list a:hover::after,
 ul.link-list a:focus-visible::after {
     opacity: 1;
     transform: translateX(0);
 }
</style>
