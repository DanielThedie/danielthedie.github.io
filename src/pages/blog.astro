---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection("blog");
allPosts.sort((a, b) => (b.data.pubDate?.getTime() ?? -Infinity) - (a.data.pubDate?.getTime() ?? -Infinity));
const pageTitle = "Blog"
const options = {
    year: "numeric",
    month: "short",
    day: "numeric",
};
---

<BaseLayout pageTitle={pageTitle}>
    <ul class="link-list">
        {allPosts.map((post: any) => <li><a href={`/blog/${post.id}/`}>
        {post.data.pubDate.toLocaleDateString("en-gb", options)} - {post.data.title}</a></li>)}
    </ul>
</BaseLayout>

<style>
 ul.link-list {
     list-style: none;
     padding: 0;
     margin: 0;
 }

 ul.link-list li + li {
     margin-top: 0.6rem;
 }

 ul.link-list a {
     display: block;
     padding: 0.65rem 0.8rem;
     border-radius: 10px;

     text-decoration: none;
     color: #1f4fd6;

     border: 1px solid transparent;
     background: transparent;

     transition: background-color 0.15s ease, border-color 0.15s ease,
     transform 0.15s ease;
 }

 ul.link-list a {
     border-left: 4px solid #c9c9c9;
     padding-left: 0.9rem;
 }

 ul.link-list a:hover,
 ul.link-list a:focus-visible {
     background: #eeeeee;
     border-color: #d0d0d0;
     transform: translateY(-1px);
     outline: none;
     border-left-color: #1f4fd6;
 }

 ul.link-list a:hover::after,
 ul.link-list a:focus-visible::after {
     opacity: 1;
     transform: translateX(0);
 }
</style>
