---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import data from '../data/software.yaml';

const { software } = data;
const pageTitle = "Software";
---

<BaseLayout pageTitle={pageTitle}>
    <div class="software">
        {software.map((item) => (
        <div class ="software-item">
            <h3>{item.title}</h3>
            <img src={item.image} alt={item.title} class="software-image">
            <strong>{item.languages}</strong>
            <div class="software-description">{item.description}</div>
            <div class="software-buttons">
                {item.github && <Button url={item.github} icon="fab fa-github" label="Code" />}
                {item.app && <Button url={item.app} icon="fa fa-globe" label="App" />}
                {item.docs && <Button url={item.docs} icon="fa fa-book-open" label="Docs" />}
                {item.doi && <Button url={item.doi} icon="fa fa-link" label="DOI" />}
            </div>
        </div>
        ))}
    </div>
</BaseLayout>

<style>
 .software {
     display: grid;
     grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
     gap: 0.5em;
     justify-items: center;
 }

 .software-item {
     display: flex;
     flex-direction: column;
     height: auto;
     width: 300px;
     background: #fff;
     border-radius: 10px;
     margin: 1em 0;
     border: 2px solid #6495ED;
     align-items: center;
     text-align: center;
 }

 .software-image {
     max-width: 250px;
     height: 100px;
     display: block;
     object-fit: cover;
     margin-bottom: 1em;
     border-radius: 10px;
 }

 .software-description {
     text-align: justify;
     padding: 1em;
     color: #555;
     font-size: 0.9em;
 }

 .software-buttons {
     display: flex;
     gap: 0.5em;
     justify-content: center;
     flex-wrap: wrap;
     margin-bottom: 1em;
     margin-left: 1em;
     margin-right: 1em;
 }
</style>
