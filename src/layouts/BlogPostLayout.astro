---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';

const { data } = Astro.props;
const options = {
    weekday: "long",
    year: "numeric",
    month: "long",
    day: "numeric",
};
---

<BaseLayout pageTitle="Blog">
    <Button url="/blog/" label="Back to list" />
    <div class="blog-item">
        <h2>{data.title}</h2>
        <p class="metadata">Posted on {data.pubDate.toLocaleDateString('en-gb', options )} by {data.author}</p>
        <slot />
    </div>
</BaseLayout>

<style>
 .blog-item {
     background: #fff;
     padding: 10px 40px;
     border-radius: 10px;
     margin: 1em 0;
     border: 2px solid #777777;
     text-align: justify;
     line-height: 1.5;
 }

 .metadata {
     font-size: 0.9em;
     color: #777777;
     margin-bottom: 3em;
     margin-top: 0;
 }
</style>
