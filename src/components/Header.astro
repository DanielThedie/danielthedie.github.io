---
import Navigation from '../components/Navigation.astro';
import Links from '../components/Links.astro';
---

<header>
    <div class="name-title">
        <h1>Daniel Thédié</h1>
    </div>

    <img src="/resources/Profile.jpg" alt="Picture of Daniel Thédié" class="profile-pic" />

    <p class="subtitle">Research Software Engineer at the University of Edinburgh</p>
    
    <Links />
    <Navigation />
</header>

<style>
 .name-title {
     margin-left: 40px;
     margin-top: 30px;
     letter-spacing: 0.06em;
     font-size: 1em;
 }

 .subtitle {
     text-align: center;
     font-size: 1.2em;
     color: #777777;
     margin-top: -10px;
     margin-bottom: 1.5em;
 }

 .profile-pic {
     display: block;
     margin: 0 auto 1em auto;
     width: 160px;
     height: 160px;
     object-fit: cover;
     border-radius: 50%;
     border: 4px solid #6495ED;
     box-shadow: 0 2px 8px rgba(0,0,0,0.08);
 }

</style>
